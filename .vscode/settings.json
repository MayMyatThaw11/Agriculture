{
  "python.defaultInterpreterPath": "${workspaceFolder}/fastapi/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/fastapi"],
  "python.envFile": "${workspaceFolder}/fastapi/.env",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["fastapi/tests"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.configuration": "${workspaceFolder}/fastapi/pyproject.toml"
}
