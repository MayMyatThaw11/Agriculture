AGROGUARD_APP_NAME=AgroGuard API
AGROGUARD_APP_VERSION=0.1.0
AGROGUARD_ENVIRONMENT=development
AGROGUARD_DEBUG=false
AGROGUARD_API_V1_PREFIX=/api/v1
AGROGUARD_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agroguard
AGROGUARD_CORS_ORIGINS=["http://localhost:5173"]
AGROGUARD_TELEGRAM_BOT_TOKEN=
AGROGUARD_TELEGRAM_CHAT_ID=

# LLM / AI
AGROGUARD_LLM_API_KEY=
AGROGUARD_LLM_ENDPOINT=https://api.openai.com/v1
AGROGUARD_LLM_MODEL=gpt-4o

# Weather
AGROGUARD_OPENWEATHER_API_KEY=
AGROGUARD_OPENWEATHER_BASE_URL=https://api.openweathermap.org

